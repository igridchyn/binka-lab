# autorun configuration for binka-lab, read by the autorun plugin (the supervisor, autorun-tail and the
# autorun:item skill). KEY=value, one per line, no expansion; an env var of the same name wins.
# NTFY_URL and NTFY_ANSWER_URL are env-only (secret topics): never put them here.
# Written for the E9.P2.0 setup; the operator's file (protected).

AUTONOMOUS=1

STATE_DIR=.autorun/state
LOG_DIR=.autorun/state/logs
PROMPT_FILE=.autorun/NEXT_TASK_PROMPT.md
LEDGER_FILE=.autorun/LEDGER.md
POLICY_FILE=.autorun/POLICY.md
NOTIFY_TITLE=binka-lab

# Model and effort per item kind (<!-- kind: X --> in the CURRENT ITEM block).
MODEL=opus
KIND_default=opus:high
KIND_design=opus:max
KIND_dossier=opus:max

# Acceptance gate. Before the scaffold (E9.P2.1) there is no package.json, so the vendored scanner over the text
# written here is the whole check (disclosure policy §4.9). From the scaffold on, `npm run check` adds tsc, eslint,
# vitest, the content build, Playwright and axe (E9 §3), and runs the scanner over src/ too (POLICY).
CHECK_CMD=python3 tools/scan.py content docs src .autorun/LEDGER.md .autorun/NEXT_TASK_PROMPT.md && { test ! -f package.json || npm run check; }
CHECK_TIMEOUT=30m
REVIEW_LEVEL=high
GATE_ROUNDS=2

MAX_ITERS=20
PER_ITEM_TIMEOUT=4h
PER_ITEM_BUDGET_USD=40
MAX_TOTAL_USD=300

# Recovery budgets.
MAX_NUDGES=1
INFRA_RETRIES=1
INFRA_BACKOFF=2m
REPAIR_ATTEMPTS=1
MAX_LIMIT_WAIT=12h
USAGE_PAUSE=1
USAGE_PAUSE_HORIZON=20m
USAGE_PAUSE_AT=95
REPAIR_ON_INTERRUPT=1
MAX_REPAIRS=2

WORKTREE=0

# A workstation, not a VM: a classifier reviews each action, and the loop-only settings deny the rest.
PERMISSION_MODE=auto
SETTINGS_FILE=.autorun/settings.loop.json

# The loop never edits its own rules or the session settings. Once E9.P2.7 has landed CI, add
# .github/workflows/** here.
PROTECTED_PATHS=.autorun/config.env,.autorun/POLICY.md,.autorun/guard_rules.py,.autorun/backlog.json,.autorun/settings.loop.json,CLAUDE.md,.claude/**
# The signed policy and the vendored scanner are binka's: they change only by a new copy from binka.
FROZEN_PATHS=docs/disclosure_policy.md,tools/scan.py
SECRET_SCAN=1
TEST_INTEGRITY=1
TEST_PATHS=tests/**

# The independent read-only verifier, on the site's code.
REVIEW_ZONES=src/**,tools/**,tests/**
VERIFY_MODEL=opus
VERIFY_EFFORT=high
VERIFY_BUDGET_USD=6
VERIFY_TIMEOUT=20m

# The supervisor (never a session) pushes each accepted item here; it deploys a preview behind Access.
# main and production are the operator's merges.
PUSH_REMOTE=origin
PUSH_BRANCH=autorun/loop

# Backlog mode: a loop with only cards left waits this long for an answer instead of exiting.
PAUSE_WAIT=12h
